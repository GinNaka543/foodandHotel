/* Terms and Privacy */
"terms_of_service" = "Nutzungsbedingungen";
"terms_of_service_title" = "Nutzungsbedingungen";
"terms_last_updated" = "Zuletzt aktualisiert: 23. Juli 2025";
"terms_article_1_title" = "Artikel 1 (Anwendung der Nutzungsbedingungen)";
"terms_article_1_content" = "Diese Nutzungsbedingungen (nachfolgend \"Bedingungen\") legen die Bedingungen für die Nutzung von ANICOLLE! (nachfolgend \"die App\") zwischen den Nutzern der App (nachfolgend \"Nutzer\") und dem Betreiber fest.";
"terms_article_2_title" = "Artikel 2 (Nutzerregistrierung)";
"terms_article_2_content" = "1. Nutzer müssen sich nach Zustimmung zu diesen Bedingungen gemäß der vorgeschriebenen Methode registrieren.\n2. Wenn bei der Registrierung falsche Informationen angegeben werden, kann die Registrierung storniert werden.";
"terms_article_3_title" = "Artikel 3 (Verwaltung von Nutzer-ID und Passwort)";
"terms_article_3_content" = "1. Nutzer müssen ihre Nutzer-ID und ihr Passwort für die App eigenverantwortlich angemessen verwalten.\n2. Der Betreiber übernimmt keine Verantwortung für Schäden, die durch die Nutzung von Nutzer-IDs und Passwörtern durch Dritte entstehen.";
"terms_article_4_title" = "Artikel 4 (Nutzungsgebühren)";
"terms_article_4_content" = "1. Die App kann ab der Erstregistrierung 2 Monate lang kostenlos genutzt werden.\n2. Nach Ablauf der kostenlosen Testphase ist eine Nutzungsgebühr von 600 Yen (inkl. Steuern) erforderlich, um die App weiterhin zu nutzen.\n3. Wenn die Nutzungsgebühr nicht bezahlt wird, können einige oder alle Funktionen der App eingeschränkt werden.\n4. Einmal bezahlte Nutzungsgebühren werden aus keinem Grund zurückerstattet.";
"terms_article_5_title" = "Artikel 5 (Verbotene Aktivitäten)";
"terms_article_5_content" = "Nutzer dürfen bei der Nutzung der App nicht an folgenden Aktivitäten teilnehmen:\n• Aktivitäten, die gegen Gesetze oder die öffentliche Ordnung und Moral verstoßen\n• Aktivitäten im Zusammenhang mit kriminellen Handlungen\n• Aktivitäten, die den Betrieb der App beeinträchtigen können\n• Aktivitäten, die persönliche Informationen über andere Nutzer sammeln oder ansammeln\n• Aktivitäten mit unbefugtem Zugriff oder Versuchen davon\n• Aktivitäten, die andere Nutzer imitieren\n• Aktivitäten, die direkt oder indirekt antisozialen Kräften im Zusammenhang mit der App Vorteile verschaffen";
"terms_article_6_title" = "Artikel 6 (Aussetzung der App-Dienste)";
"terms_article_6_content" = "Der Betreiber kann alle oder einen Teil der App-Dienste ohne vorherige Mitteilung an die Nutzer aussetzen oder unterbrechen, wenn folgende Umstände als vorliegend erachtet werden:\n• Bei Wartung, Inspektion oder Updates des mit der App verbundenen Computersystems\n• Wenn es aufgrund höherer Gewalt wie Erdbeben, Blitzschlag, Feuer, Stromausfällen oder Naturkatastrophen schwierig wird, die App bereitzustellen\n• Wenn Computer oder Kommunikationsleitungen aufgrund von Unfällen gestoppt werden";
"terms_article_7_title" = "Artikel 7 (Urheberrecht)";
"terms_article_7_content" = "1. Das Urheberrecht an Inhalten (Text, Bilder, Videos, Audio usw.), die innerhalb der App bereitgestellt werden, gehört dem Betreiber oder legitimen Rechteinhabern.\n2. Nutzer dürfen die Inhalte der App nicht über den Umfang der persönlichen Nutzung hinaus verwenden.";
"terms_article_8_title" = "Artikel 8 (Haftungsausschluss)";
"terms_article_8_content" = "1. Obwohl alle Anstrengungen unternommen werden, um die Genauigkeit der in der App veröffentlichten Informationen sicherzustellen, garantiert der Betreiber nicht die Genauigkeit, Nützlichkeit oder Aktualität der App-Informationen.\n2. Der Betreiber übernimmt keine Verantwortung für Schäden, die Nutzern durch die Nutzung der App entstehen.";
"terms_article_9_title" = "Artikel 9 (Sammlung und Weitergabe von Informationen)";
"terms_article_9_content" = "1. Die App kann Textinformationen über die von Nutzern registrierten Lieblings-Anime- und Synchronsprecher-Charaktere sammeln und diese zur Verbesserung der Dienste und zur Bereitstellung von Sharing-Funktionen mit anderen Nutzern verwenden.\n2. Durch die Nutzung der App gelten Nutzer als mit der oben genannten Informationssammlung und -weitergabe einverstanden.\n3. Andere persönliche Informationen werden gemäß der separat festgelegten Datenschutzrichtlinie angemessen behandelt.";
"terms_article_10_title" = "Artikel 10 (Nutzungsmethode)";
"terms_article_10_content" = "Beim Gerätewechsel werden Nutzer-Textinformationen gespeichert, aber Bilder werden nicht gespeichert. Nach der Anmeldung auf einem neuen Gerät müssen Bilder erneut hochgeladen werden.";
"terms_article_11_title" = "Artikel 11 (Datenschutzrichtlinie)";
"terms_article_11_content" = "Durch die Nutzung der App erhaltene persönliche Informationen werden gemäß der separat festgelegten Datenschutzrichtlinie angemessen behandelt.";
"terms_article_12_title" = "Artikel 12 (Änderungen der Nutzungsbedingungen)";
"terms_article_12_content" = "Der Betreiber kann diese Bedingungen ohne Benachrichtigung der Nutzer ändern, wenn dies als notwendig erachtet wird. Die überarbeiteten Bedingungen treten in Kraft, wenn sie innerhalb der App veröffentlicht werden.";
"terms_article_13_title" = "Artikel 13 (Anwendbares Recht und Gerichtsbarkeit)";
"terms_article_13_content" = "1. Diese Bedingungen unterliegen japanischem Recht.\n2. Alle Streitigkeiten, die im Zusammenhang mit der App entstehen, unterliegen der ausschließlichen Gerichtsbarkeit des Gerichts, das für den Standort der Hauptgeschäftsstelle des Betreibers zuständig ist.";
"privacy_policy" = "Datenschutzrichtlinie";

/* Privacy Policy */
"privacy_policy_title" = "Datenschutzrichtlinie";
"privacy_info_we_collect_title" = "1. Informationen, die wir sammeln";
"privacy_info_we_collect_content" = "Die App \"ANICOLLE!\" sammelt folgende Informationen:\n\n• Benutzer-Registrierungsinformationen (Benutzername, Benutzer-ID)\n• In der App erstellte Inhalte (Charaktere, Anime-Aufzeichnungen)\n• Geräteinformationen (Geräte-ID, OS-Version)\n• App-Nutzung (Anmeldezeiten, Häufigkeit der Funktionsnutzung)\n• Zahlungsinformationen (Zahlungsinformationen über Stripe, aber Kreditkartennummern werden nicht gespeichert)\n\nHinweis: Wir sammeln keine E-Mail-Adressen";
"privacy_purpose_title" = "2. Zweck der Informationsnutzung";
"privacy_purpose_content" = "Die gesammelten Informationen werden nur für folgende Zwecke verwendet:\n\n• Bereitstellung grundlegender App-Funktionen\n• Benutzerauthentifizierung und Kontoverwaltung\n• Zahlungs- und Punkteverwaltung\n• Sicherung von Charakter- und Anime-Informationen (zur Datenwiederherstellung)\n• App-Verbesserung und Kundensupport\n• Erfüllung rechtlicher Anforderungen\n\nHinweis: Von Ihnen registrierte Charakter- und Anime-Informationen werden ausschließlich zu Sicherungszwecken auf Servern gespeichert, um eine Datenwiederherstellung bei Geräteausfall oder -wechsel zu ermöglichen.";
"privacy_data_storage_title" = "3. Datenspeicherung und -verwaltung";
"privacy_data_storage_content" = "• Vom Benutzer erstellte Inhalte (Charakter-, Anime-Informationen) werden zu Sicherungszwecken sicher auf Firebase-Servern gespeichert\n• Dieses System ermöglicht die Datenwiederherstellung ohne Verlust in folgenden Fällen:\n  - Geräteausfall oder -verlust\n  - App-Neuinstallation\n  - Gerätewechsel\n• Authentifizierungs-, Punkte- und Zahlungsinformationen werden ebenfalls auf Firebase-Servern verwaltet\n• Alle Kommunikationen sind mit HTTPS verschlüsselt\n• Benutzer können ihre Daten jederzeit löschen\n• Sicherungsdaten werden mit Benutzerkonten verknüpft gespeichert und können nicht von anderen Benutzern aufgerufen werden";
"privacy_disclosure_title" = "4. Informationsweitergabe an Dritte";
"privacy_disclosure_content" = "Wir geben persönliche Informationen der Benutzer nicht an Dritte weiter, außer in folgenden Fällen:\n\n• Wenn die Zustimmung des Benutzers eingeholt wurde\n• Wenn die Offenlegung gesetzlich vorgeschrieben ist\n• Wenn es zum Schutz von Leben, Körper oder Eigentum erforderlich ist";
"privacy_security_title" = "5. Sicherheit";
"privacy_security_content" = "Wir implementieren folgende Maßnahmen zum angemessenen Schutz von Benutzerinformationen:\n\n• Verschlüsselung durch HTTPS-Kommunikation\n• Sichere Authentifizierung mit Firebase Authentication\n• Ordnungsgemäße API-Schlüsselverwaltung\n• Regelmäßige Sicherheitsupdates";
"privacy_cookies_title" = "6. Cookies und Tracking";
"privacy_cookies_content" = "• Diese App verwendet keine Cookies zur Verbesserung der Benutzererfahrung\n• Wir führen kein Tracking zu Werbezwecken durch\n• App-Nutzungsstatistiken werden in anonymisierter Form gesammelt\n• Gesammelte Charakter- und Anime-Informationen werden nicht für andere Zwecke als Sicherung und Wiederherstellung verwendet";
"privacy_backup_title" = "7. Datensicherung und -wiederherstellung";
"privacy_backup_content" = "Wir bieten folgende Sicherungsfunktionen zum Schutz Ihrer wertvollen Daten:\n\n• Automatische Sicherung: Automatische Speicherung auf Servern beim Registrieren oder Bearbeiten von Charakteren und Anime\n• Datenwiederherstellung: Automatische Wiederherstellung aus Sicherungsdaten bei der Anmeldung\n• Zweck der Sicherung:\n  - Datenschutz bei Geräteausfall oder -verlust\n  - Datenwiederherstellung beim Löschen und Neuinstallieren der App\n  - Datenmigration beim Gerätewechsel\n\nWichtig: Diese Sicherungsdaten werden ausschließlich zum Schutz Ihrer Daten verwendet und niemals für andere Zwecke (Marketing, Analyse, Bereitstellung an Dritte usw.).";
"privacy_children_title" = "8. Datenschutz für Kinder";
"privacy_children_content" = "Diese App ist nicht für Kinder unter 13 Jahren bestimmt. Personen unter 13 Jahren sollten vor der Nutzung die Zustimmung der Eltern einholen.";
"privacy_changes_title" = "9. Änderungen der Datenschutzrichtlinie";
"privacy_changes_content" = "Wir können unsere Datenschutzrichtlinie bei Bedarf ändern. Bei wesentlichen Änderungen werden wir die Benutzer innerhalb der App benachrichtigen.";
"privacy_contact_title" = "10. Kontakt";
"privacy_contact_content" = "Für datenschutzbezogene Anfragen kontaktieren Sie uns bitte unter:\n\nE-Mail: fneko543@gmail.com";
"privacy_last_updated" = "Zuletzt aktualisiert: 24. Juli 2025";
"privacy_agree_and_start" = "Zustimmen und App nutzen";
"privacy_agree_description" = "Durch Zustimmung zur Datenschutzrichtlinie können Sie die App nutzen";


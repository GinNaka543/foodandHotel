/* Terms and Privacy */
"terms_of_service" = "Conditions d'utilisation";
"terms_of_service_title" = "Conditions d'Utilisation";
"terms_last_updated" = "Dernière mise à jour : 23 juillet 2025";
"terms_article_1_title" = "Article 1 (Application des Conditions d'Utilisation)";
"terms_article_1_content" = "Ces Conditions d'Utilisation (ci-après dénommées \"Conditions\") définissent les conditions d'utilisation d'ANICOLLE! (ci-après dénommée \"l'Application\") entre les utilisateurs de l'Application (ci-après dénommés \"Utilisateurs\") et l'opérateur.";
"terms_article_2_title" = "Article 2 (Inscription de l'Utilisateur)";
"terms_article_2_content" = "1. Les utilisateurs doivent s'inscrire selon la méthode prescrite après avoir accepté ces Conditions.\n2. Si de fausses informations sont fournies lors de l'inscription, l'inscription peut être annulée.";
"terms_article_3_title" = "Article 3 (Gestion de l'ID Utilisateur et du Mot de Passe)";
"terms_article_3_content" = "1. Les utilisateurs doivent gérer de manière appropriée leur ID utilisateur et leur mot de passe pour l'Application sous leur propre responsabilité.\n2. L'opérateur n'assume aucune responsabilité pour les dommages résultant de l'utilisation des ID utilisateur et mots de passe par des tiers.";
"terms_article_4_title" = "Article 4 (Frais d'Utilisation)";
"terms_article_4_content" = "1. L'Application peut être utilisée gratuitement pendant 2 mois à partir de l'inscription initiale.\n2. Après la fin de la période gratuite, des frais d'utilisation de 600 yens (taxes comprises) sont nécessaires pour continuer à utiliser l'Application.\n3. Si les frais d'utilisation ne sont pas payés, certaines ou toutes les fonctions de l'Application peuvent être restreintes.\n4. Les frais d'utilisation une fois payés ne seront remboursés pour aucune raison.";
"terms_article_5_title" = "Article 5 (Activités Interdites)";
"terms_article_5_content" = "Les utilisateurs ne doivent pas s'engager dans les activités suivantes lors de l'utilisation de l'Application :\n• Activités qui violent les lois ou l'ordre public et les bonnes mœurs\n• Activités liées à des actes criminels\n• Activités susceptibles d'interférer avec le fonctionnement de l'Application\n• Activités qui collectent ou accumulent des informations personnelles sur d'autres utilisateurs\n• Activités impliquant un accès non autorisé ou des tentatives de celui-ci\n• Activités usurpant l'identité d'autres utilisateurs\n• Activités qui fournissent directement ou indirectement des avantages aux forces antisociales en relation avec l'Application";
"terms_article_6_title" = "Article 6 (Suspension des Services de l'Application)";
"terms_article_6_content" = "L'opérateur peut suspendre ou interrompre tout ou partie des services de l'Application sans préavis aux utilisateurs si l'une des circonstances suivantes est jugée exister :\n• Lors de la maintenance, de l'inspection ou de la mise à jour du système informatique lié à l'Application\n• Lorsqu'il devient difficile de fournir l'Application en raison de force majeure telle que tremblements de terre, foudre, incendie, pannes de courant ou catastrophes naturelles\n• Lorsque les ordinateurs ou les lignes de communication sont arrêtés en raison d'accidents";
"terms_article_7_title" = "Article 7 (Droits d'Auteur)";
"terms_article_7_content" = "1. Les droits d'auteur du contenu (texte, images, vidéos, audio, etc.) fourni dans l'Application appartiennent à l'opérateur ou aux détenteurs légitimes des droits.\n2. Les utilisateurs ne peuvent pas utiliser le contenu de l'Application au-delà de la portée de l'utilisation personnelle.";
"terms_article_8_title" = "Article 8 (Clause de Non-Responsabilité)";
"terms_article_8_content" = "1. Bien que tous les efforts soient faits pour garantir l'exactitude des informations publiées sur l'Application, l'opérateur ne garantit pas l'exactitude, l'utilité ou l'actualité des informations de l'Application.\n2. L'opérateur n'assume aucune responsabilité pour les dommages subis par les utilisateurs suite à l'utilisation de l'Application.";
"terms_article_9_title" = "Article 9 (Collecte d'Informations)";
"terms_article_9_content" = "1. L'Application peut collecter des informations textuelles sur les personnages d'anime et acteurs de doublage favoris enregistrés par les utilisateurs, et les utiliser pour améliorer les services.\n2. En utilisant l'Application, les utilisateurs sont réputés avoir consenti à la collecte d'informations ci-dessus.\n3. Les informations collectées ne sont pas partagées avec d'autres utilisateurs.\n4. Les autres informations personnelles seront traitées de manière appropriée conformément à la Politique de Confidentialité établie séparément.";
"terms_article_10_title" = "Article 10 (Méthode d'Utilisation)";
"terms_article_10_content" = "Lors du changement d'appareil, les informations textuelles de l'utilisateur seront sauvegardées, mais les images ne le seront pas. Après la connexion sur un nouvel appareil, les images devront être téléchargées à nouveau.";
"terms_article_11_title" = "Article 11 (Politique de Confidentialité)";
"terms_article_11_content" = "Les informations personnelles obtenues par l'utilisation de l'Application seront traitées de manière appropriée conformément à la Politique de Confidentialité établie séparément.";
"terms_article_12_title" = "Article 12 (Modifications des Conditions d'Utilisation)";
"terms_article_12_content" = "L'opérateur peut modifier ces Conditions sans en informer les utilisateurs lorsque cela est jugé nécessaire. Les Conditions révisées prendront effet lorsqu'elles seront publiées dans l'Application.";
"terms_article_13_title" = "Article 13 (Loi Applicable et Juridiction)";
"terms_article_13_content" = "1. Ces Conditions seront régies par la loi japonaise.\n2. Tout litige survenant en relation avec l'Application sera soumis à la juridiction exclusive du tribunal ayant juridiction sur l'emplacement du siège social de l'opérateur.";

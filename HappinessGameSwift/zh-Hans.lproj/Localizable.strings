/* Privacy Policy */
"privacy_policy_title" = "隐私政策";
"privacy_info_we_collect_title" = "1. 我们收集的信息";
"privacy_info_we_collect_content" = "应用程序\"ANICOLLE!\"收集以下信息：\n\n• 用户注册信息（用户名、用户ID）\n• 应用内创建的内容（角色、动漫记录）\n• 设备信息（设备ID、操作系统版本）\n• 应用使用情况（登录时间、功能使用频率）\n• 支付信息（通过Apple处理支付，详细的支付信息由Apple管理）\n\n注意：我们不收集电子邮件地址";
"privacy_purpose_title" = "2. 信息使用目的";
"privacy_purpose_content" = "收集的信息仅用于以下目的：\n\n• 提供基本应用功能\n• 用户身份验证和账户管理\n• 支付和积分管理\n• 备份角色和动漫信息（用于数据恢复）\n• 应用改进和客户支持\n• 响应法律要求\n\n注意：您注册的角色和动漫信息仅出于备份目的存储在服务器上，允许在设备故障或更换时恢复数据。";
"privacy_data_storage_title" = "3. 数据存储和管理";
"privacy_data_storage_content" = "• 用户创建的内容（角色、动漫信息）安全地存储在Firebase服务器上用于备份\n• 此系统允许在以下情况下恢复数据而不丢失：\n  - 设备故障或丢失\n  - 应用重新安装\n  - 设备更换\n• 身份验证信息、积分信息和支付信息也在Firebase服务器上管理\n• 所有通信都使用HTTPS加密\n• 用户可以随时删除他们的数据\n• 备份数据与用户账户关联存储，其他用户无法访问";
"privacy_disclosure_title" = "4. 向第三方披露信息";
"privacy_disclosure_content" = "除以下情况外，我们不会向第三方提供用户的个人信息：\n\n• 获得用户同意时\n• 法律要求披露时\n• 保护生命、身体或财产所必需时";
"privacy_security_title" = "5. 安全性";
"privacy_security_content" = "我们实施以下措施来妥善保护用户信息：\n\n• 通过HTTPS通信加密\n• 使用Firebase Authentication进行安全身份验证\n• 妥善的API密钥管理\n• 定期安全更新";
"privacy_cookies_title" = "6. Cookie和跟踪";
"privacy_cookies_content" = "• 此应用不使用cookie来改善用户体验\n• 我们不进行广告目的的跟踪\n• 应用使用统计数据以匿名形式收集\n• 收集的角色和动漫信息不用于备份和恢复以外的目的";
"privacy_backup_title" = "7. 数据备份和恢复";
"privacy_backup_content" = "我们提供以下备份功能来保护您的宝贵数据：\n\n• 自动备份：注册或编辑角色和动漫时自动保存到服务器\n• 数据恢复：登录时自动从备份数据恢复\n• 备份目的：\n  - 在设备故障或丢失时保护数据\n  - 删除并重新安装应用时恢复数据\n  - 更换设备时迁移数据\n\n重要：此备份数据仅用于保护您的数据，绝不用于其他目的（营销、分析、提供给第三方等）。";
"privacy_children_title" = "8. 儿童隐私";
"privacy_children_content" = "此应用不适用于13岁以下的儿童。13岁以下的用户应在使用前获得父母同意。";
"privacy_changes_title" = "9. 隐私政策的变更";
"privacy_changes_content" = "我们可能会根据需要更改隐私政策。如有重大变更，我们将在应用内通知用户。";
"privacy_contact_title" = "10. 联系我们";
"privacy_contact_content" = "有关隐私的查询，请通过以下方式联系我们：\n\n电子邮件：fneko543@gmail.com";
"privacy_last_updated" = "最后更新：2025年7月24日";

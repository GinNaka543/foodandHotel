/* Privacy Policy */
"privacy_policy_title" = "Politique de Confidentialité";
"privacy_info_we_collect_title" = "1. Informations que Nous Collectons";
"privacy_info_we_collect_content" = "L'application \"ANICOLLE!\" collecte les informations suivantes :\n\n• Informations d'inscription des utilisateurs (nom d'utilisateur, ID utilisateur)\n• Contenu créé dans l'application (enregistrements de personnages, anime)\n• Informations sur l'appareil (ID de l'appareil, version du système d'exploitation)\n• Utilisation de l'application (heures de connexion, fréquence d'utilisation des fonctionnalités)\n• Informations de paiement (les paiements sont traités via Apple, les informations de paiement détaillées sont gérées par Apple)\n\nNote : Nous ne collectons pas les adresses e-mail";
"privacy_purpose_title" = "2. Objectif de l'Utilisation des Informations";
"privacy_purpose_content" = "Les informations collectées sont utilisées uniquement aux fins suivantes :\n\n• Fournir les fonctionnalités de base de l'application\n• Authentification des utilisateurs et gestion des comptes\n• Gestion des paiements et des points\n• Sauvegarde des informations de personnages et d'anime (pour la récupération de données)\n• Amélioration de l'application et support client\n• Répondre aux exigences légales\n\nNote : Les informations de personnages et d'anime que vous enregistrez sont stockées sur des serveurs uniquement à des fins de sauvegarde, permettant la récupération de données en cas de panne ou de remplacement d'appareil.";
"privacy_data_storage_title" = "3. Stockage et Gestion des Données";
"privacy_data_storage_content" = "• Le contenu créé par l'utilisateur (informations sur les personnages, anime) est stocké en toute sécurité sur les serveurs Firebase à des fins de sauvegarde\n• Ce système permet la récupération de données sans perte dans les cas suivants :\n  - Panne ou perte de l'appareil\n  - Réinstallation de l'application\n  - Remplacement de l'appareil\n• Les informations d'authentification, de points et de paiement sont également gérées sur les serveurs Firebase\n• Toutes les communications sont cryptées avec HTTPS\n• Les utilisateurs peuvent supprimer leurs données à tout moment\n• Les données de sauvegarde sont stockées en lien avec les comptes utilisateurs et ne peuvent pas être consultées par d'autres utilisateurs";
"privacy_disclosure_title" = "4. Divulgation d'Informations à des Tiers";
"privacy_disclosure_content" = "Nous ne fournissons pas les informations personnelles des utilisateurs à des tiers, sauf dans les cas suivants :\n\n• Lorsque le consentement de l'utilisateur est obtenu\n• Lorsque la divulgation est requise par la loi\n• Lorsque nécessaire pour protéger la vie, le corps ou la propriété";
"privacy_security_title" = "5. Sécurité";
"privacy_security_content" = "Nous mettons en œuvre les mesures suivantes pour protéger correctement les informations des utilisateurs :\n\n• Cryptage via communication HTTPS\n• Authentification sécurisée avec Firebase Authentication\n• Gestion appropriée des clés API\n• Mises à jour de sécurité régulières";
"privacy_cookies_title" = "6. Cookies et Suivi";
"privacy_cookies_content" = "• Cette application n'utilise pas de cookies pour améliorer l'expérience utilisateur\n• Nous ne suivons pas à des fins publicitaires\n• Les statistiques d'utilisation de l'application sont collectées sous forme anonyme\n• Les informations de personnages et d'anime collectées ne sont pas utilisées à des fins autres que la sauvegarde et la récupération";
"privacy_backup_title" = "7. Sauvegarde et Récupération de Données";
"privacy_backup_content" = "Nous fournissons les fonctionnalités de sauvegarde suivantes pour protéger vos données précieuses :\n\n• Sauvegarde automatique : Sauvegarde automatique sur les serveurs lors de l'enregistrement ou de la modification de personnages et d'anime\n• Récupération de données : Restauration automatique à partir des données de sauvegarde lors de la connexion\n• Objectif de la sauvegarde :\n  - Protection des données en cas de panne ou de perte d'appareil\n  - Récupération des données lors de la suppression et réinstallation de l'application\n  - Migration des données lors du changement d'appareil\n\nImportant : Ces données de sauvegarde sont utilisées uniquement pour protéger vos données et ne sont jamais utilisées à d'autres fins (marketing, analyse, fourniture à des tiers, etc.).";
"privacy_children_title" = "8. Confidentialité des Enfants";
"privacy_children_content" = "Cette application n'est pas destinée aux enfants de moins de 13 ans. Les personnes de moins de 13 ans doivent obtenir le consentement parental avant utilisation.";
"privacy_changes_title" = "9. Modifications de la Politique de Confidentialité";
"privacy_changes_content" = "Nous pouvons modifier notre politique de confidentialité si nécessaire. En cas de changements importants, nous informerons les utilisateurs dans l'application.";
"privacy_contact_title" = "10. Nous Contacter";
"privacy_contact_content" = "Pour les questions relatives à la confidentialité, veuillez nous contacter à :\n\nE-mail : koyasutsubame529@gmail.com";
"privacy_last_updated" = "Dernière mise à jour : 24 juillet 2025";
"privacy_agree_and_start" = "Accepter et Commencer à Utiliser l'Application";
"privacy_agree_description" = "En acceptant la Politique de Confidentialité, vous pouvez commencer à utiliser l'application";

